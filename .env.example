# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Папка с документами компании (.md, .txt, .html, .pdf; подпапки читаются, папки на "_" и "." пропускаются)
KB_DIR=examples/kb
DATABASE_PATH=data/kb.db

# Как называть компанию в ответах и что предложить, если ответа нет
COMPANY_NAME=Hotel Alpina Bolzano
CONTACT_TEXT=Напишите на reception@hotel-alpina.example или позвоните +39 0471 000 000.

# Ответы ИИ (Claude). Ключ: console.anthropic.com → API Keys. Без ключа бот показывает найденные фрагменты.
ANTHROPIC_API_KEY=
# auto — ИИ, если есть ключ; llm — только ИИ; extractive — только фрагменты (бесплатно)
ANSWER_MODE=auto
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high: насколько глубоко модель думает (выше — точнее и дороже)
CLAUDE_EFFORT=medium

# Поиск: сколько фрагментов отдавать ИИ и размер фрагмента (символов)
TOP_K=5
CHUNK_CHARS=1200

# Telegram-бот (токен от @BotFather)
BOT_TOKEN=
# Кто может /reindex и /stats (Telegram ID через запятую, свой ID — у @userinfobot)
ADMIN_IDS=
# Кто может задавать вопросы. Пусто — все. Для внутренней базы сотрудников впишите их ID.
ALLOWED_USER_IDS=
# Защита бюджета: вопросов в час на одного пользователя (админов не касается)
QUESTIONS_PER_HOUR=20
MAX_QUESTION_CHARS=1000
